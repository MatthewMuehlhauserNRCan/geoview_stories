{
  "name": "geoview-stories",
  "version": "0.1.0",
  "description": "Interactive storytelling library for GeoView maps",
  "private": true,
  "main": "src/index.tsx",
  "license": "MIT",
  "scripts": {
    "watch:lib": "vite build --watch --mode development --config vite.lib.config.ts",
    "serve:static": "serve . -l 3000",
    "serve": "concurrently -k \"npm:watch:lib\" \"npm:serve:static\"",
    "dev:editor": "vite --config vite.editor.config.ts",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:editor": "vite build --config vite.editor.config.ts",
    "build": "npm run build:lib && npm run build:editor && node scripts/copy-static.mjs",
    "deploy": "gh-pages -d dist",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"editor/src/**/*.{ts,tsx,css}\"",
    "lint": "eslint src editor/src",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p editor/tsconfig.json"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.2",
    "@mui/system": "^9.1.2",
    "jszip": "^3.10.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "geoview-core-types": "github:Canadian-Geospatial-Platform/geoview#types",
    "gh-pages": "^6.3.0",
    "ol": "^10.9.0",
    "prettier": "^3.4.2",
    "serve": "^14.2.0",
    "terser": "^5.36.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-css-injected-by-js": "^3.5.2"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
